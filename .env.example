# Copy to .env and adjust. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEV   →  TOR_ENABLED=true, SHOW_BROWSER=true (optional), npm run dev
# RAILWAY     →  set ACCOUNT_PASSWORD + GROQ_API_KEY in Railway env vars
#                TOR_ENABLED must be false/unset on Railway (no Tor daemon)
#                PORT is auto-set by Railway
#                Signups share one datacenter IP → site may rate-limit. Defaults:
#                PARALLEL_BROWSERS=1, VOTES_PER_SESSION=1, jitter + longer signup wait.
#                For volume: set PROXY_MODE=proxies + PROXIES or PROXY_FILE (residential).
# ─────────────────────────────────────────────────────────────────────────────

UI_PORT=3000

# How many votes to run in one browser instance before rotating the Tor circuit.
# Set to 1 for a fresh Tor exit node on every single vote.
VOTES_PER_SESSION=1

# Set to "true" to watch the Chromium window (local only)
SHOW_BROWSER=false
SLOW_MO=0

# Password used for every creativeaward.ai signup account
ACCOUNT_PASSWORD=ta123#$55

# ── Tor (local only; leave TOR_ENABLED=false on Vercel) ──────────────────────
TOR_ENABLED=false
TOR_PROXY_PORT=9150
TOR_CONTROL_PORT=9151
# TOR_CONTROL_PASSWORD=
# TOR_COOKIE_FILE=

# Comma-separated HTTP/HTTPS proxies (optional; Tor takes priority when enabled)
PROXIES=
# Use file-based proxy list instead of PROXIES (see proxies/webshare_*.txt)
# PROXY_FILE=
# On Railway without Tor, force proxy use: PROXY_MODE=proxies

# ── Concurrency / rate limits (optional; cloud has safer defaults) ──────────
# PARALLEL_BROWSERS=5
# WORKER_STAGGER_MS=2000
# SIGNUP_POST_WAIT_MS=12000
# VOTE_JITTER_MS_MAX=20000
# SIGNUP_FAIL_COOLDOWN_BASE_SEC=45

# ── Temp email provider ─────────────────────────────────────────────────────
# "mailtm"     — mail.tm (default on cloud; uses less-known domains)
# "guerrilla"  — Guerrilla Mail (guerrillamailblock.com — blocked by many sites)
# EMAIL_PROVIDER=mailtm

# ── Groq — Ethiopian name generation ─────────────────────────────────────────
# Get a free key at https://console.groq.com/
# Without a key the bot still works, using a local Ethiopian name pool.
GROQ_API_KEY=
